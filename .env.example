# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=murder
POSTGRES_PASSWORD=murder
POSTGRES_DB=murder
INTERNAL_API_KEY=dev-internal-key

# AI model used by ai-service. Default: Ollama on your laptop (free, https://ollama.com),
# after `ollama pull gemma3:4b`. Docker reaches it at host.docker.internal; on Linux, start
# Ollama with OLLAMA_HOST=0.0.0.0 so containers can reach it.
AI_PROVIDER=ollama
AI_MODEL=gemma3:4b
# AI_BASE_URL=http://localhost:11434/v1     # default; Docker uses host.docker.internal

# Azure OpenAI instead (ask the AI team for the key):
# AI_PROVIDER=azure
# AI_BASE_URL=https://mm-g10-openai.openai.azure.com/openai/v1
# AI_MODEL=gpt-5-mini                       # or gpt-4.1-mini
# AI_API_KEY=
# AI_REASONING_EFFORT=minimal               # gpt-5 models only

# AI_TIMEOUT_SECONDS=20

# Frontend (npm run dev): "true" fakes the lobby API and Socket.IO with local data, for working
# before the backend implements them. Leave false to see the real backend's errors.
VITE_USE_MOCK=false
