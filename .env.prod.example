# Server-only settings (/opt/murder-mystery/.env). Never commit the real file.
DOMAIN=murder-mystery-g10.polandcentral.cloudapp.azure.com
IMAGE_TAG=latest

POSTGRES_USER=murder
POSTGRES_PASSWORD=change-me            # hex only (it goes into a URL)
POSTGRES_DB=murder
INTERNAL_API_KEY=change-me

# AI model (Azure OpenAI resource mm-g10-openai, on the second Azure subscription)
AI_PROVIDER=azure
AI_BASE_URL=https://mm-g10-openai.openai.azure.com/openai/v1
AI_MODEL=gpt-5-mini
AI_API_KEY=change-me                   # key2 of the resource; key1 is for the AI team
AI_REASONING_EFFORT=minimal

# Dozzle at https://$DOMAIN/logs
LOGS_USER=admin
LOGS_PASSWORD_HASH='$2a$14$replace-with-caddy-hash-password-output'   # single quotes: keeps the $ signs
