# HTTPS certificates are obtained and renewed automatically (Let's Encrypt).
{$DOMAIN} {
	# Container logs (Dozzle), behind a password
	handle /logs* {
		basic_auth {
			{$LOGS_USER} {$LOGS_PASSWORD_HASH}
		}
		reverse_proxy dozzle:8080
	}

	# The game: frontend nginx serves the app and proxies /api and /socket.io to the backend
	handle {
		reverse_proxy frontend:8080
	}
}
