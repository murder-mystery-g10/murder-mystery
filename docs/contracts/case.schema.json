{
  "$defs": {
    "Accusation": {
      "additionalProperties": false,
      "description": "The culprit is picked among the suspects; motive and method among 4 options each.",
      "properties": {
        "motive_options": {
          "items": {
            "$ref": "#/$defs/AccusationOption"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Motive Options",
          "type": "array"
        },
        "correct_motive": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Correct Motive",
          "type": "string"
        },
        "method_options": {
          "items": {
            "$ref": "#/$defs/AccusationOption"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Method Options",
          "type": "array"
        },
        "correct_method": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Correct Method",
          "type": "string"
        }
      },
      "required": [
        "motive_options",
        "correct_motive",
        "method_options",
        "correct_method"
      ],
      "title": "Accusation",
      "type": "object"
    },
    "AccusationOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "AccusationOption",
      "type": "object"
    },
    "BreakStage": {
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "description": "Alternatives (OR) of evidence combinations (AND); ids are clue or testimony ids. A combination is met once all its ids have been shown to this suspect, possibly across different questions.",
          "items": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Triggers",
          "type": "array"
        },
        "admits": {
          "description": "What the suspect admits at this stage",
          "title": "Admits",
          "type": "string"
        },
        "unlocks": {
          "description": "Testimony ids the suspect only shares from this stage on",
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Unlocks",
          "type": "array"
        }
      },
      "required": [
        "triggers",
        "admits"
      ],
      "title": "BreakStage",
      "type": "object"
    },
    "Briefing": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "title": "When",
          "type": "string"
        },
        "where": {
          "title": "Where",
          "type": "string"
        },
        "victim": {
          "$ref": "#/$defs/Person"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "discovery": {
          "title": "Discovery",
          "type": "string"
        },
        "coroner_report": {
          "items": {
            "type": "string"
          },
          "title": "Coroner Report",
          "type": "array"
        },
        "story_hooks": {
          "items": {
            "$ref": "#/$defs/StoryHook"
          },
          "title": "Story Hooks",
          "type": "array"
        }
      },
      "required": [
        "when",
        "where",
        "victim",
        "summary",
        "discovery",
        "coroner_report"
      ],
      "title": "Briefing",
      "type": "object"
    },
    "CaseRoom": {
      "additionalProperties": false,
      "properties": {
        "room": {
          "description": "Room id from the theme map",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Room",
          "type": "string"
        },
        "lock": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "code": "#/$defs/CodeLock",
                  "key": "#/$defs/KeyLock"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KeyLock"
                },
                {
                  "$ref": "#/$defs/CodeLock"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None means open at the start",
          "title": "Lock"
        }
      },
      "required": [
        "room"
      ],
      "title": "CaseRoom",
      "type": "object"
    },
    "Clue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "object": {
          "description": "Clickable object id from the theme map",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Object",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClueType"
        },
        "pillar": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pillar"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only for critical (C) clues"
        },
        "also": {
          "description": "Secondary roles",
          "items": {
            "$ref": "#/$defs/ClueType"
          },
          "title": "Also",
          "type": "array"
        },
        "icon": {
          "$ref": "#/$defs/ClueIcon"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "player_text": {
          "description": "Exactly what the player reads when they find it",
          "title": "Player Text",
          "type": "string"
        },
        "proves": {
          "title": "Proves",
          "type": "string"
        },
        "refutes": {
          "description": "False-lead clue ids it disproves",
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Refutes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "icon",
        "title",
        "player_text",
        "proves"
      ],
      "title": "Clue",
      "type": "object"
    },
    "ClueIcon": {
      "enum": [
        "letter",
        "document",
        "bottle",
        "key",
        "photo",
        "item"
      ],
      "title": "ClueIcon",
      "type": "string"
    },
    "ClueType": {
      "enum": [
        "C",
        "F",
        "E",
        "P",
        "A",
        "T"
      ],
      "title": "ClueType",
      "type": "string"
    },
    "CodeLock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "code",
          "default": "code",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint_clues": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Hint Clues",
          "type": "array"
        }
      },
      "required": [
        "code",
        "hint_clues"
      ],
      "title": "CodeLock",
      "type": "object"
    },
    "Deflection": {
      "additionalProperties": false,
      "properties": {
        "suspect": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Suspect",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        }
      },
      "required": [
        "suspect",
        "claim"
      ],
      "title": "Deflection",
      "type": "object"
    },
    "Difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "KeyLock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key",
          "default": "key",
          "title": "Type",
          "type": "string"
        },
        "key_clue": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Key Clue",
          "type": "string"
        }
      },
      "required": [
        "key_clue"
      ],
      "title": "KeyLock",
      "type": "object"
    },
    "ObjectText": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "description": "Clickable object id from the theme map, with no clue on it",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Object",
          "type": "string"
        },
        "text": {
          "description": "What the player reads when they inspect the object",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "object",
        "text"
      ],
      "title": "ObjectText",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "Person",
      "type": "object"
    },
    "Pillar": {
      "enum": [
        "method",
        "means",
        "motive",
        "opportunity"
      ],
      "title": "Pillar",
      "type": "string"
    },
    "PlayerSlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "rooms": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Rooms",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rooms"
      ],
      "title": "PlayerSlot",
      "type": "object"
    },
    "StoryHook": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "points_to_room": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Points To Room",
          "type": "string"
        }
      },
      "required": [
        "text",
        "points_to_room"
      ],
      "title": "StoryHook",
      "type": "object"
    },
    "Suspect": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "age": {
          "title": "Age",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "archetype": {
          "description": "Character type; picks the portrait set",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Archetype",
          "type": "string"
        },
        "personality": {
          "title": "Personality",
          "type": "string"
        },
        "speech_style": {
          "title": "Speech Style",
          "type": "string"
        },
        "initial_statement": {
          "title": "Initial Statement",
          "type": "string"
        },
        "secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for innocents; the culprit's secret is the crime",
          "title": "Secret"
        },
        "lies_about": {
          "items": {
            "type": "string"
          },
          "title": "Lies About",
          "type": "array"
        },
        "deflects_to": {
          "items": {
            "$ref": "#/$defs/Deflection"
          },
          "title": "Deflects To",
          "type": "array"
        },
        "testimonies": {
          "items": {
            "$ref": "#/$defs/Testimony"
          },
          "title": "Testimonies",
          "type": "array"
        },
        "break_stages": {
          "description": "In order; innocents usually have one, the culprit several",
          "items": {
            "$ref": "#/$defs/BreakStage"
          },
          "minItems": 1,
          "title": "Break Stages",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "age",
        "role",
        "archetype",
        "personality",
        "speech_style",
        "initial_statement",
        "lies_about",
        "break_stages"
      ],
      "title": "Suspect",
      "type": "object"
    },
    "Testimony": {
      "additionalProperties": false,
      "description": "Verbal clue: something true the suspect says only when asked about it precisely.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "fact": {
          "title": "Fact",
          "type": "string"
        },
        "trigger": {
          "description": "What the question must be about for the suspect to say it",
          "title": "Trigger",
          "type": "string"
        },
        "event": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timeline event the testimony is about",
          "title": "Event"
        }
      },
      "required": [
        "id",
        "fact",
        "trigger"
      ],
      "title": "Testimony",
      "type": "object"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "description": "Story time label, e.g. '21:45'; list order is chronological",
          "title": "Time",
          "type": "string"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "proven_by": {
          "description": "Physical clue ids",
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Proven By",
          "type": "array"
        },
        "witnessed_by": {
          "description": "Suspects who know about this event; a suspect's sheet only includes these",
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "title": "Witnessed By",
          "type": "array"
        }
      },
      "required": [
        "id",
        "time",
        "event"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "Truth": {
      "additionalProperties": false,
      "properties": {
        "culprit": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Culprit",
          "type": "string"
        },
        "motive": {
          "title": "Motive",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/TimelineEvent"
          },
          "minItems": 1,
          "title": "Timeline",
          "type": "array"
        }
      },
      "required": [
        "culprit",
        "motive",
        "method",
        "timeline"
      ],
      "title": "Truth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "case_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Case Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "theme": {
      "description": "theme_id of the map this case is built on",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Theme",
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "player_count": {
      "maximum": 5,
      "minimum": 3,
      "title": "Player Count",
      "type": "integer"
    },
    "questions_per_suspect": {
      "minimum": 1,
      "title": "Questions Per Suspect",
      "type": "integer"
    },
    "briefing": {
      "$ref": "#/$defs/Briefing"
    },
    "truth": {
      "$ref": "#/$defs/Truth"
    },
    "suspects": {
      "items": {
        "$ref": "#/$defs/Suspect"
      },
      "minItems": 3,
      "title": "Suspects",
      "type": "array"
    },
    "rooms": {
      "items": {
        "$ref": "#/$defs/CaseRoom"
      },
      "title": "Rooms",
      "type": "array"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/PlayerSlot"
      },
      "title": "Players",
      "type": "array"
    },
    "clues": {
      "items": {
        "$ref": "#/$defs/Clue"
      },
      "title": "Clues",
      "type": "array"
    },
    "object_texts": {
      "description": "Texts for objects without clues, shown when a player inspects them",
      "items": {
        "$ref": "#/$defs/ObjectText"
      },
      "title": "Object Texts",
      "type": "array"
    },
    "accusation": {
      "$ref": "#/$defs/Accusation"
    },
    "reveal": {
      "description": "Final reveal story, generated with the case",
      "title": "Reveal",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "title",
    "theme",
    "difficulty",
    "player_count",
    "questions_per_suspect",
    "briefing",
    "truth",
    "suspects",
    "rooms",
    "players",
    "clues",
    "accusation",
    "reveal"
  ],
  "title": "Case",
  "type": "object"
}
