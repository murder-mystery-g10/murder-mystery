{
  "client_to_server": {
    "system:ping": {
      "payload": "Ping",
      "ack": "Pong",
      "description": "Connectivity check"
    },
    "lobby:select_case": {
      "payload": "SelectCase",
      "ack": "Ack",
      "description": "Host picks the case"
    },
    "lobby:start": {
      "payload": "StartGame",
      "ack": "Ack",
      "description": "Host starts the game"
    },
    "room:enter": {
      "payload": "EnterRoom",
      "ack": "Ack",
      "description": "Move to one of your rooms, or to the station"
    },
    "room:unlock": {
      "payload": "UnlockRoom",
      "ack": "Ack",
      "description": "Use a key from your notebook or enter a code"
    },
    "object:inspect": {
      "payload": "InspectObject",
      "ack": "InspectAck",
      "description": "Click an object; found clues go to your notebook"
    },
    "board:pin": {
      "payload": "BoardPin",
      "ack": "Ack",
      "description": "Pin a clue, suspect or quote (station only)"
    },
    "board:add_note": {
      "payload": "BoardAddNote",
      "ack": "Ack",
      "description": "Add a free note"
    },
    "board:edit_note": {
      "payload": "BoardEditNote",
      "ack": "Ack",
      "description": "Edit a note"
    },
    "board:move": {
      "payload": "BoardMove",
      "ack": "Ack",
      "description": "Move an item"
    },
    "board:connect": {
      "payload": "BoardConnect",
      "ack": "Ack",
      "description": "Link two items with a string"
    },
    "board:remove": {
      "payload": "BoardRemove",
      "ack": "Ack",
      "description": "Remove an item or a link"
    },
    "interrogation:ask": {
      "payload": "Ask",
      "ack": "Ack",
      "description": "Ask a suspect (station only); uses one of the team's questions"
    },
    "accusation:propose": {
      "payload": "AccusationChoices",
      "ack": "Ack",
      "description": "Propose the final accusation"
    },
    "accusation:vote": {
      "payload": "VoteAccusation",
      "ack": "Ack",
      "description": "Accept or reject the proposal"
    }
  },
  "server_to_client": {
    "lobby:state": {
      "payload": "LobbyState",
      "description": "Lobby changed; sent to everyone in it"
    },
    "game:snapshot": {
      "payload": "GameSnapshot",
      "description": "Full personal state, at start and on reconnect"
    },
    "presence:update": {
      "payload": "PresenceUpdate",
      "description": "Who is where (top bar)"
    },
    "room:unlocked": {
      "payload": "RoomUnlocked",
      "description": "A door opened for everyone with access"
    },
    "board:state": {
      "payload": "BoardState",
      "description": "The whole board, after every change"
    },
    "interrogation:thinking": {
      "payload": "SuspectRef",
      "description": "A suspect is answering; wait for them"
    },
    "interrogation:answer": {
      "payload": "InterrogationAnswer",
      "description": "A suspect answered"
    },
    "interrogation:unavailable": {
      "payload": "SuspectUnavailable",
      "description": "The AI did not answer; the question was not used"
    },
    "accusation:state": {
      "payload": "AccusationState",
      "description": "Accusation proposed, voted or rejected"
    },
    "game:ended": {
      "payload": "GameResult",
      "description": "Score, correct answers, reveal and missed clues"
    }
  }
}
